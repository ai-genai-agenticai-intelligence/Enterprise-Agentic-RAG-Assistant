# --- REASONING ENGINE (GROQ) ---
GROQ_API_KEY="your_primary_groq_api_key_here"
GROQ_FALLBACK_API_KEY="your_fallback_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_GUARD_MODEL="openai/gpt-oss-20b"

# --- VECTOR DATABASE (QDRANT) ---
QDRANT_API_KEY="your_qdrant_api_key_here"
QDRANT_CLUSTER_ENDPOINT="https://your-cluster-endpoint.sa-east-1-0.aws.cloud.qdrant.io"

# --- GEMINI EMBEDDINGS ---
GEMINI_API_KEY="your_gemini_api_key_here"

# --- OBSERVABILITY (PYDANTIC LOGFIRE) ---
LOGFIRE_TOKEN="your_logfire_token_here"

# --- LLM GATEWAY (PORTKEY) ---
PORTKEY_API_KEY="your_portkey_api_key_here"
PORTKEY_CONFIG_ID="pc-your-portkey-config-slug-here"

# --- OBSERVABILITY (LANGSMITH) [OPTIONAL] ---
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="rag_scale_test"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
